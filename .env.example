POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_dev_password
POSTGRES_DB=taskflow
# Host-side Python/Alembic only. Containers build their URL from POSTGRES_* and host db.
DATABASE_URL=postgresql+psycopg2://taskflow:taskflow_dev_password@localhost:5432/taskflow

# Loopback-only published ports. Use 0 for an automatically allocated host port.
POSTGRES_PORT=5432
API_PORT=8000

# Required at API startup, but not required by Alembic.
# Supply a cryptographically random secret of at least 32 bytes; never commit the real value.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
